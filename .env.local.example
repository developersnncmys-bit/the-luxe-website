# Copy to .env.local and adjust as needed. The storefront reads these
# at build time (server components) and in the browser (public vars).

# Base URL of the TLV backend. Server components use this during SSR;
# NEXT_PUBLIC_API_URL is also exposed to the browser for client fetches.
# No trailing slash.
#
# Local dev against a backend on your machine:
#   API_URL=http://localhost:4000
#   NEXT_PUBLIC_API_URL=http://localhost:4000
#
# Point at the deployed Vercel backend:
API_URL=https://tlv-backend.vercel.app
NEXT_PUBLIC_API_URL=https://tlv-backend.vercel.app
